<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calc_bg"
    android:fitsSystemWindows="true">

    <!-- readout / display -->
    <TextView
        android:id="@+id/tvExpression"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/calc_text_dim"
        android:textSize="28sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/calc_text"
        android:textSize="44sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvExpression"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="12dp"
        android:columnCount="4"
        android:rowCount="6"
        app:alignmentMode="alignMargins"
        app:useDefaultMargins="false"
        app:layout_constraintTop_toBottomOf="@id/tvResult"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Row 1 : AC, BACK, %, ÷ -->
        <Button android:id="@+id/btnClear" style="@style/CalcBtn.Func"
            android:text="AC" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_column="0" app:layout_row="0" />

        <Button android:id="@+id/btnBack" style="@style/CalcBtn.Func"
            android:text="⌫" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_column="1" app:layout_row="0" />

        <Button android:id="@+id/btnPercent" style="@style/CalcBtn.Func"
            android:text="%" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_column="2" app:layout_row="0" />

        <Button android:id="@+id/btnDiv" style="@style/CalcBtn.Op"
            android:text="÷" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_column="3" app:layout_row="0" />

        <!-- Row 2 -->
        <Button android:id="@+id/btn7" style="@style/CalcBtn.Num"
            android:text="7" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_column="0" app:layout_row="1" />
        <Button android:id="@+id/btn8" style="@style/CalcBtn.Num"
            android:text="8" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_column="1" app:layout_row="1" />
        <Button android:id="@+id/btn9" style="@style/CalcBtn.Num"
            android:text="9" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_column="2" app:layout_row="1" />
        <Button android:id="@+id/btnMul" style="@style/CalcBtn.Op"
            android:text="×" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_column="3" app:layout_row="1" />

        <!-- Row 3 -->
        <Button android:id="@+id/btn4" style="@style/CalcBtn.Num"
            android:text="4" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_column="0" app:layout_row="2" />
        <Button android:id="@+id/btn5" style="@style/CalcBtn.Num"
            android:text="5" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_column="1" app:layout_row="2" />
        <Button android:id="@+id/btn6" style="@style/CalcBtn.Num"
            android:text="6" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_column="2" app:layout_row="2" />
        <Button android:id="@+id/btnMinus" style="@style/CalcBtn.Op"
            android:text="-" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_column="3" app:layout_row="2" />

        <!-- Row 4 -->
        <Button android:id="@+id/btn1" style="@style/CalcBtn.Num"
            android:text="1" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_column="0" app:layout_row="3" />
        <Button android:id="@+id/btn2" style="@style/CalcBtn.Num"
            android:text="2" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_column="1" app:layout_row="3" />
        <Button android:id="@+id/btn3" style="@style/CalcBtn.Num"
            android:text="3" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_column="2" app:layout_row="3" />
        <Button android:id="@+id/btnPlus" style="@style/CalcBtn.Op"
            android:text="+" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_column="3" app:layout_row="3" />

        <!-- Row 5 -->
        <Button android:id="@+id/btnOpen" style="@style/CalcBtn.Func"
            android:text="(" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_column="0" app:layout_row="4" />
        <Button android:id="@+id/btn0" style="@style/CalcBtn.Num"
            android:text="0" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_column="1" app:layout_row="4" />
        <Button android:id="@+id/btnDot" style="@style/CalcBtn.Num"
            android:text="." app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_column="2" app:layout_row="4" />
        <Button android:id="@+id/btnClose" style="@style/CalcBtn.Func"
            android:text=")" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_column="3" app:layout_row="4" />

        <!-- Row 6 (= full width) -->
        <Button android:id="@+id/btnEq" style="@style/CalcBtn.Eq"
            android:layout_columnSpan="4" android:text="="
            app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_column="0" app:layout_row="5" />
    </androidx.gridlayout.widget.GridLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
