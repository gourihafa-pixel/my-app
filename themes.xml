<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.CalculatorVault" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/calc_btn_eq</item>
        <item name="colorPrimaryVariant">@color/calc_btn_eq</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorAccent">@color/calc_btn_op</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/calc_bg</item>
        <item name="android:windowBackground">@color/calc_bg</item>
    </style>

    <!-- Calculator button styles -->
    <style name="CalcBtn">
        <item name="android:textColor">@color/calc_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="CalcBtn.Num">
        <item name="parent">@style/CalcBtn</item>
        <item name="android:background">@drawable/bg_btn_num</item>
    </style>

    <style name="CalcBtn.Func">
        <item name="parent">@style/CalcBtn</item>
        <item name="android:background">@drawable/bg_btn_func</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="CalcBtn.Op">
        <item name="parent">@style/CalcBtn</item>
        <item name="android:background">@drawable/bg_btn_op</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="CalcBtn.Eq">
        <item name="parent">@style/CalcBtn</item>
        <item name="android:background">@drawable/bg_btn_eq</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
